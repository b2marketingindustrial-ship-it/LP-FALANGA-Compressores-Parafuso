---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2). Grid desktop: texto · janela do banner · shortcode.
 * A coluna 2 é a janela do banner; nunca coloque conteúdo nela.
 * Abra a página com `?grid=1` para ver as colunas e o início da foto.
 *
 * Desvio pedido pelo cliente em 22/10/2026 (mockup "Compressores Schulz", docs/BRIEFING.md):
 * fundo navy com malha de blueprint à esquerda; os compressores Schulz começam logo depois
 * do texto, com a foto ancorada ao fim da coluna 1 até a borda da tela; o H1 com a
 * palavra-chave é a linha de abertura, acima da manchete ("Mais ar." em branco, o resto em
 * amarelo); quatro pontos em grade 2×2 com ícone amarelo; um único CTA em pílula amarela.
 * O shortcode do chat fica sozinho na coluna 3, sem card nem cabeçalho (23/10/2026).
 * Conteúdo até 1680px, como o "Como funciona" e os diferenciais: a coluna de texto tem
 * largura fixa e a janela do banner fica com o resto, para os três compressores caberem
 * entre o texto e o chat.
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import { hero, cta } from '../data/content'

const isDev = import.meta.env.DEV
---

<section class="hero relative overflow-hidden [container-type:inline-size]" data-hero>
  {/* z0 — malha de blueprint à esquerda, como no mockup */}
  <div aria-hidden="true" class="hero-blueprint pointer-events-none absolute inset-0 z-0"></div>

  {/* z1 — banner: faixa no rodapé da seção no mobile; no desktop, do fim da coluna de texto à borda da tela */}
  <div class="hero-photo hero-fade absolute inset-x-0 bottom-0 z-[1] h-[300px] lg:inset-y-0 lg:h-auto">
    <Picture
      src={hero.banner.src}
      alt={hero.banner.alt}
      widths={[640, 1024, 1377]}
      sizes="(min-width: 1024px) 1300px, 700px"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      quality="high"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-left"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>

  {/* z5 — conteúdo */}
  <div class="page-container relative z-[5] pt-14 pb-[320px] lg:py-24">
    <div class="hero-grid grid items-center gap-y-12 lg:min-h-[600px] lg:gap-x-6">
      {/* Coluna 1 — textos */}
      <div class="max-w-xl lg:max-w-none">
        {/* H1 com a palavra-chave da campanha, na forma de linha de abertura */}
        <h1 class="flex items-center gap-4 font-sans text-[13px] font-semibold tracking-[0.14em] text-neutral-light/90 uppercase sm:text-[15px]">
          <span
            aria-hidden="true"
            class="h-[3px] w-12 shrink-0 rounded-full bg-brand-yellow"
          ></span>
          {hero.title}
        </h1>

        {/* Manchete visual: cada item é uma linha */}
        <p class="mt-5 font-display text-[2.4rem] leading-[1.02] font-extrabold tracking-[-0.035em] text-neutral-light sm:text-[3.25rem] lg:text-[3rem] xl:text-[3.75rem] 2xl:text-[4.5rem]">
          {hero.headline.map((line) => (
            <span class="block">{line}</span>
          ))}
          {hero.highlight.map((line) => (
            <span class="block text-brand-yellow">{line}</span>
          ))}
        </p>

        <p class="mt-6 max-w-[34rem] font-sans text-lg leading-relaxed text-neutral-light/90 2xl:text-xl">
          {hero.text}
        </p>

        {/* 4 pontos numa linha só (pedido do usuário, 23/10/2026): ícone amarelo em cima, texto
            sempre em duas linhas. Abaixo de 640px voltam à grade 2×2, por falta de largura. */}
        <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 sm:flex sm:items-start sm:gap-x-7 xl:gap-x-9">
          {hero.points.map((point) => (
            <li class="flex flex-col gap-2.5">
              <Icon name={point.icon} class="size-8 shrink-0 text-brand-yellow" />
              <span class="font-sans text-[14px] leading-snug font-semibold text-neutral-light xl:text-[15px]">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>

        <button type="button" data-cta="hero-primary" class="btn-slave-whats cta cta-yellow mt-10">
          {cta.primary}
          <Icon name="arrow-right" class="shrink-0" />
        </button>
      </div>

      {/* Coluna 2 — VAZIA de propósito: janela do banner */}
      <div class="hidden lg:block" aria-hidden="true"></div>

      {/* Coluna 3 — só o shortcode do chat, sem card em volta (pedido do usuário, 23/10/2026) */}
      <div class="hero-chat w-full lg:w-[340px]">
        <div class="min-h-[340px] w-full">
          <slot name="shortcode">
            {isDev ? (
              <div
                class="flex min-h-[340px] w-full flex-col gap-3 text-left"
                aria-label="Mock do chat (só em desenvolvimento)"
              >
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-yellow uppercase">
                  Mock · chat
                </span>
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="mt-auto h-12 rounded-full bg-brand-yellow" />
              </div>
            ) : (
              <div class="flex min-h-[340px] w-full flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-neutral-light/30 p-6 text-center">
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                  Espaço reservado
                </span>
                <p class="font-display text-lg font-bold text-neutral-light">Shortcode — 300px</p>
              </div>
            )}
          </slot>
        </div>
      </div>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="hero-photo absolute inset-0 hidden lg:block">
      <div class="absolute inset-y-0 left-0 border-l-2 border-dashed border-brand-yellow">
        <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] whitespace-nowrap text-brand-yellow">
          início da foto
        </span>
      </div>
    </div>
    <div class="page-container h-full">
      <div class="hero-grid grid h-full lg:gap-x-6">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-brand-yellow lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-brand-yellow">
            col 2 · janela do banner · vazia
          </span>
        </div>
        <div class="hidden border-x border-dashed border-white/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 340px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Navy do mockup, um pouco mais claro no alto à esquerda, onde fica a malha. */
  .hero {
    background:
      radial-gradient(900px 520px at 22% 0%, rgb(0 92 190 / 0.32) 0%, transparent 62%),
      linear-gradient(180deg, #01264e 0%, #012751 55%, #012856 100%);
  }

  /* Malha de blueprint do mockup: linhas finas, mais fortes no alto à esquerda. */
  .hero-blueprint {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 55% 75% at 18% 22%, #000 0%, transparent 78%);
    mask-image: radial-gradient(ellipse 55% 75% at 18% 22%, #000 0%, transparent 78%);
  }

  /* Borda da página (conteúdo até 1680px, padding de 48px) e fim da coluna de texto. */
  .hero-photo,
  .hero-grid {
    --page-max: var(--container-page);
    --page-edge: max(0px, calc(50% - var(--page-max) / 2));
    --text-col: 540px;
    --col-end: calc(var(--page-edge) + 3rem + var(--text-col));
    /* Quanto a foto começa antes do fim da coluna de texto. */
    --photo-pull: 60px;
  }

  /* Mobile: a faixa da foto no rodapé do hero nasce do fundo navy, sem borda reta. */
  .hero-fade {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7rem);
    mask-image: linear-gradient(to bottom, transparent 0, #000 7rem);
  }

  @media (min-width: 1024px) {
    /* Col 1 texto (largura fixa) | Col 2 janela do banner | Col 3 shortcode */
    .hero-grid {
      grid-template-columns: minmax(0, var(--text-col)) minmax(0, 1fr) 340px;
    }

    /* A foto começa um pouco antes do fim da coluna de texto e vai até a borda da tela: */
    /* o compressor amarelo, o primeiro da esquerda, fica logo depois dos pontos e do CTA. */
    .hero-photo {
      left: calc(var(--col-end) - var(--photo-pull));
      right: 0;
    }

    /* A borda esquerda da foto some no navy da seção. Máscara, e não véu, para não haver cor a casar. */
    .hero-fade {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        rgb(0 0 0 / 0.6) 40px,
        #000 90px
      );
      mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.6) 40px, #000 90px);
    }
  }

  /* Telas largas: a foto puxa mais para a esquerda, para o MSV 20 sair de baixo do chat. */
  @media (min-width: 1536px) {
    .hero-photo,
    .hero-grid {
      --text-col: 560px;
      --photo-pull: 100px;
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
