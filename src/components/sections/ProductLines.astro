---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2.
 *
 * VARIANTE LOCAL herdada da LP de manutenção da Falanga (mockup da seção de serviços,
 * 21/10/2026, docs/BRIEFING.md): cabeçalho à esquerda com duas fotos à direita, cards
 * numerados. Nesta LP de produto, cada card mostra o chip, a foto do
 * equipamento e as três características, como no card da biblioteca, e a faixa de marcas
 * virou as linhas do catálogo Schulz (`range`), na mesma grade dos produtos.
 * O contrato da seção é o mesmo da biblioteca — dados, CTAs `linhas-{id}`, um card
 * escuro, `tone`/`rhythm` (a faixa final de CTA saiu a pedido do usuário, 23/10/2026).
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 * Recompor a página exige reaplicá-la a partir do git.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines, type RangeLine } from '@data/sections/linhas'
import type { Photo } from '@data/types'

type Props = SectionProps

const { tone, rhythm } = Astro.props
// Uma grade só (pedido do usuário, 23/10/2026): os produtos e, depois deles, as linhas do
// catálogo Schulz no mesmo formato de card. Linha sem foto mostra o espaço da imagem.
interface Card {
  id: string
  tag: string
  title: string
  description: string
  photo?: Photo
  features: readonly string[]
  dark: boolean
}
// Todos os cards com o mesmo visual, sem destacar nenhum (pedido do usuário, 23/10/2026):
// o contrato da biblioteca exige um item `dark: true` nos dados, então o flag fica lá e é
// ignorado aqui.
const lines: Card[] = [
  ...productLines.items.map((item) => ({ ...item, dark: false })),
  ...productLines.range.items.map((item: RangeLine) => ({
    id: item.id,
    tag: item.power,
    title: `Linha ${item.name}`,
    description: `Compressores de parafuso Schulz de ${item.power}, com ${item.speed.toLowerCase()}.`,
    photo: item.photo,
    features: [item.speed, item.highlight, 'Compressor de parafuso'],
    dark: false,
  })),
]
const [photo1, photo2] = productLines.gallery
const energy = productLines.energy

// O marcador amarelo cobre `energy.highlight` dentro do título; o texto inteiro continua em `energy.title`.
const markAt = energy.title.indexOf(energy.highlight)
const energyLead = markAt >= 0 ? energy.title.slice(0, markAt).trimEnd() : energy.title
const energyMark = markAt >= 0 ? energy.highlight : ''
const energyTail =
  markAt >= 0 ? energy.title.slice(markAt + energy.highlight.length).trimStart() : ''
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-stretch lg:gap-12">
    {/* Cabeçalho */}
    <div class="max-w-2xl">
      <p class="flex items-center gap-4 font-sans text-[13px] font-bold tracking-[0.14em] text-brand-blue uppercase sm:text-[14px]">
        <span aria-hidden="true" class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"></span>
        {productLines.eyebrow}
      </p>
      <h2 class="mt-4 font-display title-section leading-[1.08] font-extrabold tracking-[-0.03em] text-primary-dark">
        {productLines.title}
      </h2>
      <p class="mt-5 max-w-xl font-sans text-lead text-ink-soft">{productLines.text}</p>
      {/* Destaque da distribuição no Nordeste (pedido do usuário, 23/10/2026) */}
      <p class="mt-7 inline-flex items-center gap-4 rounded-2xl border border-brand-blue/15 bg-brand-mist py-3 pr-6 pl-3">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-blue text-neutral-light shadow-[0_10px_20px_-12px_rgba(0,67,161,0.8)]">
          <Icon name="map-pin" class="size-6" />
        </span>
        <span>
          <span class="block font-display text-[17px] leading-tight font-extrabold text-primary-dark sm:text-[19px]">
            {productLines.area}
          </span>
          <span class="mt-1 block font-sans text-[14px] font-medium text-ink-soft">
            {productLines.areaNote}
          </span>
        </span>
      </p>
    </div>

    {/* Duas fotos, a primeira com o selo. No desktop as duas têm a altura da coluna de texto
        (pedido do usuário, 23/10/2026): a foto fica absoluta para não empurrar a linha. */}
    <div class="grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-center gap-3 sm:gap-4 lg:items-stretch">
      <figure class="relative h-56 overflow-hidden rounded-2xl bg-neutral-gray-100 sm:h-72 lg:h-auto">
        <Image
          src={photo1.src}
          alt={photo1.alt}
          width={450}
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover lg:absolute lg:inset-0"
        />
        <span class="absolute bottom-3 left-3 flex items-center gap-2 rounded-full bg-neutral-light px-3 py-2 font-sans text-[12px] font-bold text-brand-blue shadow-[0_10px_24px_-14px_rgba(0,33,71,0.6)] sm:bottom-4 sm:left-4 sm:px-4 sm:py-2.5 sm:text-[14px]">
          <Icon name={productLines.badge.icon} class="size-4 shrink-0 sm:size-5" />
          {productLines.badge.label}
        </span>
      </figure>
      <figure class="relative h-56 overflow-hidden rounded-2xl bg-neutral-gray-100 sm:h-72 lg:h-auto">
        <Image
          src={photo2.src}
          alt={photo2.alt}
          width={680}
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover lg:absolute lg:inset-0"
        />
      </figure>
    </div>
  </div>
</Section>

{/* Abertura, catálogo e economia de energia viram três seções (pedido do usuário,
    23/10/2026), com o respiro padrão e fundo alternado: o catálogo vai no cinza, entre as
    duas brancas. O ritmo é o mesmo da composição; o tom do catálogo é fixo aqui. */}
<Section id="catalogo" tone="gray" rhythm={rhythm}>
  <div>
    {/* Cabeçalho da grade em duas colunas alinhadas pela base: eyebrow e título à esquerda;
        texto e categorias à direita, no lugar das pílulas soltas no vazio */}
    <div class="grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-16">
      <div>
        <p class="flex items-center gap-4 font-sans text-[13px] font-bold tracking-[0.14em] text-brand-blue uppercase">
          <span
            aria-hidden="true"
            class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"
          ></span>
          {productLines.catalog.eyebrow}
        </p>
        <h2 class="mt-4 font-display title-section leading-[1.08] font-extrabold tracking-[-0.03em] text-primary-dark sm:whitespace-pre-line">
          {productLines.catalog.title}
        </h2>
      </div>
      <div>
        <p class="font-sans text-lead text-ink-soft md:whitespace-pre-line">
          {productLines.catalog.text}
        </p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Linha Schulz">
          {productLines.catalog.categories.map((category) => (
            <li class="flex items-center gap-2 rounded-full border border-brand-blue/15 bg-neutral-light py-1.5 pr-3.5 pl-1.5 font-sans text-[13px] font-semibold whitespace-nowrap text-primary-dark shadow-[0_6px_16px_-12px_rgba(0,33,71,0.4)]">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-yellow-soft text-[#00256f]">
                <Icon name={category.icon} class="size-3.5" />
              </span>
              {category.label}
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Cards de produto e das linhas Schulz numa grade só, todos iguais. Abaixo de 1024px
        viram trilho com rolagem, como os diferenciais: 8 cards empilhados passavam de 4.800px. */}
    <div data-lines>
      <div class="lines-track scroll-track -mx-6 mt-10 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pt-1 pb-6 lg:mx-0 lg:grid lg:grid-cols-4 lg:gap-5 lg:overflow-visible lg:p-0">
        {lines.map((line, i) => (
          <article
            class:list={[
              'flex w-[82%] shrink-0 snap-start flex-col rounded-2xl border p-5 sm:w-[46%] lg:w-auto transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0 xl:p-6',
              line.dark
                ? 'border-transparent bg-[linear-gradient(160deg,#0550ab_0%,#0043a1_55%,#003a8f_100%)] shadow-[0_24px_48px_-28px_rgba(0,55,127,0.8)]'
                : 'border-[#e3e8f1] bg-neutral-light shadow-[0_10px_30px_-24px_rgba(0,33,71,0.35)] hover:shadow-[0_24px_48px_-28px_rgba(0,33,71,0.4)]',
            ]}
          >
            <div class="flex items-center justify-between">
              <span
                class:list={[
                  'rounded-full px-3 py-1 font-sans text-[11px] font-bold tracking-[0.12em] uppercase',
                  line.dark
                    ? 'bg-brand-yellow text-primary-dark-900'
                    : 'bg-brand-yellow-soft text-[#00256f]',
                ]}
              >
                {line.tag}
              </span>
              <span
                class:list={[
                  'font-display text-[17px] font-bold',
                  line.dark ? 'text-neutral-light/45' : 'text-[#c0c9df]',
                ]}
              >
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            {/* Palco do produto: o fundo branco da foto some no multiply */}
            <figure
              class:list={[
                'mt-4 flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl p-3',
                line.dark
                  ? 'bg-neutral-light'
                  : 'bg-[linear-gradient(180deg,#f5f7fa_0%,#ffffff_100%)]',
              ]}
            >
              {line.photo ? (
                <Image
                  src={line.photo.src}
                  alt={line.photo.alt}
                  width={400}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-contain mix-blend-multiply"
                />
              ) : (
                <span class="flex h-full w-full flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-[#d5dcea] text-[#9aa7bf]">
                  <Icon name="camera" class="size-8" />
                  <span class="font-sans text-[12px] font-semibold tracking-[0.12em] uppercase">
                    Imagem · {line.title.replace('Linha ', '')}
                  </span>
                </span>
              )}
            </figure>

            <h3
              class:list={[
                'mt-5 font-display text-[21px] leading-[1.2] font-extrabold tracking-[-0.015em] lg:text-[19px] xl:text-[20px] 2xl:text-[22px]',
                line.dark ? 'text-neutral-light' : 'text-brand-blue',
              ]}
            >
              {line.title}
            </h3>
            <p
              class:list={[
                'mt-2 font-sans text-[15px] leading-relaxed',
                line.dark ? 'text-neutral-light/85' : 'text-ink-soft',
              ]}
            >
              {line.description}
            </p>

            <ul class="mt-4 space-y-2" aria-label={`Características: ${line.title}`}>
              {line.features.map((feature) => (
                <li
                  class:list={[
                    'flex items-center gap-2.5 font-sans text-[14px] font-medium',
                    line.dark ? 'text-neutral-light/90' : 'text-ink',
                  ]}
                >
                  <span
                    class:list={[
                      'flex size-5 shrink-0 items-center justify-center rounded-full',
                      line.dark
                        ? 'bg-brand-yellow text-primary-dark-900'
                        : 'bg-brand-yellow-soft text-[#00256f]',
                    ]}
                  >
                    <Icon name="check" class="size-3 [stroke-width:2.4]" />
                  </span>
                  {feature}
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-6">
              <button
                type="button"
                data-cta={`linhas-${line.id}`}
                class:list={[
                  'btn-slave-whats inline-flex w-full max-w-[16.5rem] items-center justify-between gap-4 border-b-2 pb-2 font-sans text-[15px] font-bold transition-colors duration-200 motion-reduce:transition-none',
                  line.dark
                    ? 'border-white/45 text-neutral-light hover:border-brand-yellow'
                    : 'border-brand-blue/25 text-brand-blue hover:border-brand-blue',
                ]}
              >
                {cta.card}
                <Icon
                  name="arrow-right"
                  class:list={[
                    'size-5 shrink-0 [stroke-width:2.2]',
                    line.dark ? 'text-brand-yellow' : 'text-brand-blue',
                  ]}
                />
              </button>
            </div>
          </article>
        ))}
      </div>

      <div class="flex items-center justify-center gap-3 lg:hidden">
        <button
          type="button"
          data-rail-prev
          aria-label="Produto anterior"
          class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark"
        >
          <Icon name="chevron-right" class="size-4 rotate-180" />
        </button>
        <button
          type="button"
          data-rail-next
          aria-label="Próximo produto"
          class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark"
        >
          <Icon name="chevron-right" class="size-4" />
        </button>
      </div>
    </div>

    <p class="mt-4 font-sans text-[12px] text-ink-soft">{productLines.range.note}</p>
  </div>

  {/* Gráfico velocidade constante × variável: barras sobem, a seta se desenha e o "50%" conta
      quando o gráfico entra na tela (pedido do usuário, 23/10/2026). Sem JavaScript, ou com
      movimento reduzido, aparece pronto. */}
</Section>

<Section id="economia" tone={tone} rhythm={rhythm}>
  {/* No desktop, o card do gráfico estica até a altura da coluna de texto e a área das
      barras cresce para ocupar o espaço (pedido do usuário, 23/10/2026). */}
  <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-stretch lg:gap-14">
    {/* No celular o texto vem antes do gráfico, para o título abrir a seção */}
    <figure
      data-energy-chart
      class="energy-chart order-2 flex flex-col rounded-2xl border border-[#e3e8f1] bg-brand-mist/60 p-4 sm:p-7 lg:order-1"
    >
      <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2">
        <span class="flex items-center gap-2 font-sans text-[13px] font-semibold text-ink-soft">
          <span aria-hidden="true" class="energy-fixed size-3.5 rounded-[4px]"></span>
          {energy.legend.fixed}
        </span>
        <span class="flex items-center gap-2 font-sans text-[13px] font-semibold text-ink-soft">
          <span aria-hidden="true" class="energy-variable size-3.5 rounded-[4px]"></span>
          {energy.legend.variable}
        </span>
      </div>

      <div
        aria-hidden="true"
        class="relative mt-5 h-64 border-b-2 border-primary-dark/15 sm:h-72 lg:h-auto lg:min-h-64 lg:flex-1"
      >
        {/* Destaque do "até 50%", sobre as barras baixas */}
        <div class="energy-callout absolute top-0 left-[27%] flex items-center gap-3 sm:left-[29%]">
          <span class="font-display leading-none font-extrabold text-brand-blue">
            <span class="block font-sans text-[13px] font-bold [word-spacing:0.15em] italic sm:text-[15px]">
              {energy.saving.prefix}
            </span>
            <span class="text-[2.6rem] tracking-[-0.04em] italic sm:text-[3.4rem]">
              <span data-energy-count>{energy.saving.value}</span>%
            </span>
          </span>
          <span class="border-l-2 border-brand-blue/30 pl-3 font-display text-[12px] leading-tight font-extrabold tracking-[0.04em] text-primary-dark uppercase sm:text-[14px]">
            <span class="block">{energy.saving.label[0]}</span>
            <span class="block">{energy.saving.label[1]}</span>
          </span>
        </div>

        <div class="grid h-full grid-cols-4">
          {energy.groups.map((group, i) => (
            <div class="flex h-full items-end justify-center">
              <div class="relative flex h-full items-end gap-1 sm:gap-1.5">
                <span
                  class="energy-bar energy-fixed w-6 rounded-t-md sm:w-9"
                  style={`height: ${group.fixed}%; --delay: ${i * 160}ms`}
                ></span>
                <span
                  class="energy-bar energy-variable w-6 rounded-t-md sm:w-9"
                  style={`height: ${group.variable}%; --delay: ${i * 160 + 90}ms`}
                ></span>
                {i === 0 && (
                  <span
                    class="energy-arrow absolute -right-4 sm:-right-5"
                    style={`top: 0; height: ${group.fixed - group.variable}%`}
                  ></span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Rótulos menores no celular, com hifenização, para "Investimento" e "Manutenção"
          não encostarem um no outro em colunas de ~70px */}
      <div aria-hidden="true" class="mt-3 grid grid-cols-4 gap-1 sm:gap-2">
        {energy.groups.map((group) => (
          <span class="text-center font-sans text-[11px] leading-tight font-medium hyphens-auto text-ink-soft sm:text-[13px]">
            {group.label}
          </span>
        ))}
      </div>

      <figcaption class="sr-only">
        {energy.title} Comparação entre {energy.legend.fixed.toLowerCase()} e{' '}
        {energy.legend.variable.toLowerCase()}, em altura relativa:{' '}
        {energy.groups.map((g) => `${g.label}, ${g.fixed} contra ${g.variable}`).join('; ')}.
      </figcaption>
    </figure>

    {/* Coluna de texto: eyebrow, título com marcador, texto, as duas reduções do
        comparativo em destaque e o CTA com a nota de atendimento */}
    <div class="order-1 lg:order-2">
      <p class="flex items-center gap-4 font-sans text-[13px] font-bold tracking-[0.14em] text-brand-blue uppercase">
        <span aria-hidden="true" class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"></span>
        {energy.eyebrow}
      </p>
      <h2 class="mt-4 font-display title-section leading-[1.08] font-extrabold tracking-[-0.03em] text-primary-dark">
        {energyLead} {energyMark && <mark class="energy-mark text-brand-blue">{energyMark}</mark>}{' '}
        {energyTail}
      </h2>
      <p class="mt-4 font-sans text-lead text-ink-soft">{energy.text}</p>

      <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-4">
        {energy.stats.map((stat) => (
          <li class="flex items-center gap-3 rounded-xl border border-[#e3e8f1] bg-neutral-light px-3.5 py-3 shadow-[0_10px_24px_-20px_rgba(0,33,71,0.45)]">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand-blue text-brand-yellow">
              <Icon name="bolt" class="size-[18px]" />
            </span>
            <span class="min-w-0">
              <span class="flex flex-wrap items-baseline gap-x-1.5">
                <span class="font-sans text-[12px] font-bold text-ink-soft">{stat.prefix}</span>
                <span class="font-display text-[24px] leading-none font-extrabold tracking-[-0.02em] text-primary-dark">
                  {stat.value}
                </span>
                <span class="font-sans text-[13px] font-medium whitespace-nowrap text-ink-soft">
                  {stat.label}
                </span>
              </span>
              <span class="mt-1 block font-sans text-[11px] font-bold tracking-[0.12em] text-brand-blue uppercase">
                {stat.line}
              </span>
            </span>
          </li>
        ))}
      </ul>

      <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
        <button type="button" data-cta="linhas-energia" class="btn-slave-whats cta cta-blue">
          {energy.cta}
          <Icon name="arrow-right" class="shrink-0" />
        </button>
        <p class="flex max-w-[17rem] items-center gap-2.5 font-sans text-[14px] leading-snug text-ink-soft">
          <Icon name="users" class="size-5 shrink-0 text-brand-blue" />
          {energy.ctaNote}
        </p>
      </div>
    </div>
  </div>

  <BrandCarousel />
</Section>

<style>
  /* Marcador amarelo atrás do "até 50%" do título. */
  .energy-mark {
    background: linear-gradient(
      transparent 62%,
      rgb(253 224 1 / 0.75) 62%,
      rgb(253 224 1 / 0.75) 92%,
      transparent 92%
    );
    padding-inline: 0.08em;
  }

  .energy-fixed {
    background-color: #a9b2bf;
  }

  .energy-variable {
    background-image: linear-gradient(180deg, var(--color-brand-blue) 0%, #003a8f 100%);
  }

  /* Seta dupla entre o topo das duas barras de consumo: a diferença de energia. */
  .energy-arrow {
    width: 2px;
    background-color: var(--color-primary-dark);
  }

  .energy-arrow::before,
  .energy-arrow::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 9px;
    height: 9px;
    border-color: var(--color-primary-dark);
    border-style: solid;
    border-width: 0;
  }

  .energy-arrow::before {
    top: 0;
    border-top-width: 2px;
    border-left-width: 2px;
    transform: translateX(-50%) rotate(45deg);
  }

  .energy-arrow::after {
    bottom: 0;
    border-bottom-width: 2px;
    border-right-width: 2px;
    transform: translateX(-50%) rotate(45deg);
  }

  /* Estado inicial, só quando o script assumiu o gráfico (data-ready) e ainda não animou. */
  .energy-chart[data-ready] .energy-bar {
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
  }

  .energy-chart[data-ready] .energy-arrow {
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.5s ease-out 0.75s;
  }

  .energy-chart[data-ready] .energy-callout {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease-out 0.7s,
      transform 0.5s ease-out 0.7s;
  }

  .energy-chart[data-animated] .energy-bar,
  .energy-chart[data-animated] .energy-arrow {
    transform: scaleY(1);
  }

  .energy-chart[data-animated] .energy-callout {
    opacity: 1;
    transform: none;
  }

  /* O script já não anima com movimento reduzido; isto cobre a troca da preferência depois. */
  @media (prefers-reduced-motion: reduce) {
    .energy-chart .energy-bar,
    .energy-chart .energy-arrow,
    .energy-chart .energy-callout {
      transition: none;
    }
  }
</style>

<script>
  // Setas do trilho de produtos no mobile.
  document.querySelectorAll<HTMLElement>('[data-lines]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.lines-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-rail-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-rail-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('article')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })

  // Anima o gráfico de energia uma vez, quando ele entra na tela. Com movimento reduzido,
  // não assume o gráfico: ele fica como veio do HTML, já completo.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('[data-energy-chart]').forEach((chart) => {
    if (reduce || !('IntersectionObserver' in window)) return

    const counter = chart.querySelector<HTMLElement>('[data-energy-count]')
    const target = Number(counter?.textContent ?? 0)
    if (counter) counter.textContent = '0'
    chart.setAttribute('data-ready', '')

    const count = () => {
      if (!counter) return
      const start = performance.now()
      const duration = 900
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration)
        counter.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))))
        if (t < 1) requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        observer.disconnect()
        chart.setAttribute('data-animated', '')
        window.setTimeout(count, 750)
      },
      { threshold: 0.35 },
    )
    observer.observe(chart)
  })
</script>
