---
/**
 * Como funciona — fase "apoio" da biblioteca B2.
 *
 * VARIANTE LOCAL desta LP, pedida pelo cliente em 21/10/2026 (mockup "Do diagnóstico
 * ao compressor em operação", docs/BRIEFING.md): painel navy com o fim do título em
 * amarelo, as etapas numa trilha com círculos amarelos numerados ligados por uma linha
 * com setas, cada etapa num card contornado com ícone amarelo. CTA e selo da equipe
 * ficam ao lado do cabeçalho, que não mostra o `text` (removido a pedido do usuário); em 23/10/2026 o bloco foi compactado (título, círculos e
 * cards menores, ícone ao lado do título do card). O contrato da seção é o mesmo da biblioteca — etapas, CTA
 * `processo-cta`, painel navy, `tone`/`rhythm`.
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 * Recompor a página exige reaplicá-la a partir do git.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { process } from '@data/sections/processo'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const steps = process.steps

// O trecho em amarelo é o fim do título; o texto inteiro continua em `process.title`.
const cut = process.title.lastIndexOf(process.highlight)
const lead = cut >= 0 ? process.title.slice(0, cut).trimEnd() : process.title
const highlight = cut >= 0 ? process.highlight : ''
---

<Section id="processo" tone={tone} rhythm={rhythm} container={false}>
  {/* Painel na largura do conteúdo da página (page-container), como as outras seções. */}
  <div class="page-container">
    <div class="process-panel relative overflow-hidden rounded-[28px] p-6 shadow-[0_24px_60px_-34px_rgba(0,24,48,0.8)] sm:p-8 lg:p-10">
      <div class="relative">
        {/* Cabeçalho: título à esquerda; à direita, uma barra de vidro com o selo da equipe e o
            CTA lado a lado, centrada na altura do título */}
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
          <div class="min-w-0">
            <p class="flex items-center gap-4 font-sans text-[13px] font-semibold tracking-[0.2em] text-[#8bcdff] uppercase">
              <span
                aria-hidden="true"
                class="h-[4px] w-10 shrink-0 rounded-full bg-brand-yellow"
              ></span>
              {process.eyebrow}
            </p>
            <h2 class="mt-3 font-display text-[2rem] leading-[1.08] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-[2.5rem] xl:text-[2.75rem]">
              {lead} {highlight && <span class="text-brand-yellow sm:block">{highlight}</span>}
            </h2>
          </div>

          <div class="process-action flex shrink-0 flex-col items-start gap-4 rounded-2xl p-4 sm:flex-row sm:items-center sm:gap-6 sm:py-2.5 sm:pr-2.5 sm:pl-5">
            <p class="flex items-center gap-3">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-yellow/15 text-brand-yellow">
                <Icon name="shield-check" class="size-6" />
              </span>
              <span class="font-display text-[16px] leading-tight font-bold text-neutral-light">
                {process.microcopy}
              </span>
            </p>
            <button type="button" data-cta="processo-cta" class="btn-slave-whats cta cta-yellow">
              {process.cta}
              <Icon name="arrow-right" class="shrink-0" />
            </button>
          </div>
        </div>

        {/* Trilha de etapas: círculo numerado sobre a linha, card com ícone e título lado a lado */}
        <ol
          class="process-track relative mt-10 grid gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-[repeat(var(--process-steps),minmax(0,1fr))]"
          style={`--process-steps: ${steps.length}`}
        >
          <span
            aria-hidden="true"
            class="process-line pointer-events-none absolute inset-x-0 top-[21px] hidden h-[2px] lg:block"
          ></span>
          {steps.map((step, i) => (
            <li class="relative flex flex-col items-center">
              {i > 0 && (
                <span
                  aria-hidden="true"
                  class="absolute top-4 -left-[13px] hidden size-0 border-y-[6px] border-l-[10px] border-y-transparent border-l-brand-yellow lg:block"
                />
              )}
              <span class="relative z-[2] flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-yellow font-display text-[16px] font-extrabold text-primary-dark-900">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="-mt-[22px] w-full flex-1 rounded-2xl border border-[#1f5fa8]/80 bg-white/[0.03] px-5 pt-9 pb-5">
                {/* Altura de duas linhas no desktop, para as descrições começarem na mesma altura */}
                <div class="flex items-center gap-3 lg:min-h-[2.75rem]">
                  <Icon name={step.icon} class="size-6 shrink-0 text-brand-yellow" />
                  <h3 class="font-display text-[16px] leading-snug font-extrabold text-neutral-light xl:text-[17px]">
                    {step.title}
                  </h3>
                </div>
                <p class="mt-2.5 font-sans text-[14px] leading-relaxed text-neutral-light/75">
                  {step.description}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Fundo do mockup: navy com um brilho azul no canto superior direito e na base. */
  .process-panel {
    background:
      radial-gradient(1000px 520px at 100% -10%, rgb(0 78 150 / 0.55) 0%, transparent 62%),
      radial-gradient(900px 320px at 55% 115%, rgb(0 80 150 / 0.6) 0%, transparent 70%),
      linear-gradient(160deg, #003770 0%, #012b59 45%, #002a5c 100%);
  }

  /* Barra do selo e do CTA: vidro discreto sobre o navy do painel. */
  .process-action {
    background-image: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.1) 0%,
      rgb(255 255 255 / 0.03) 100%
    );
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  /* Linha da trilha, na altura do centro dos círculos, esmaecendo nas pontas. */
  .process-line {
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-brand-yellow) 7%,
      var(--color-brand-yellow) 93%,
      transparent 100%
    );
  }
</style>
