---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * VARIANTE LOCAL desta LP, pedida pelo cliente em 21/10/2026 (mockup "Reduza o tempo de
 * inatividade", docs/BRIEFING.md): bloco navy em largura total com o fim do título em
 * amarelo, CTA em pílula amarela e a área atendida; à direita, uma foto única (o técnico
 * já está nela) fechada por uma faixa amarela curva; e os 5 cards sobrepostos à base,
 * com ícone em quadrado amarelo ao lado do texto. Conteúdo e cards vão até 1450px, como
 * o "Como funciona". O contrato é o mesmo da biblioteca — 5 motivos, CTA
 * `diferenciais-cta`, bloco navy, `tone`/`rhythm`.
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 * Recompor a página exige reaplicá-la a partir do git.
 */
import { Picture } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const titleTop = why.titleLines.slice(0, -1)
const titleBottom = why.titleLines.at(-1)
---

<Section id="diferenciais" tone={tone} rhythm={rhythm} container={false} class="relative">
  {/* Bloco navy em largura total */}
  <div
    class="why-hero relative overflow-hidden"
    style="margin-top: calc(-1 * var(--section-space) - var(--lp-round)); padding-top: var(--lp-round)"
  >
    {/* Foto à direita (desktop), com a borda esquerda esmaecida no navy */}
    <div class="why-photo absolute inset-y-0 right-0 hidden w-[58%] lg:block">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1020]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>

    {/* Faixa amarela curva fechando a foto à direita (desktop) */}
    <svg
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 z-[1] hidden h-full w-[7%] min-w-[84px] lg:block"
      viewBox="0 0 100 600"
      preserveAspectRatio="none"
    >
      <path d="M100 0H80C72 220 55 420 0 600h100Z" fill="#001e40"></path>
      <path
        d="M80 0C72 220 55 420 0 600"
        fill="none"
        stroke="var(--color-brand-yellow)"
        stroke-width="10"
        vector-effect="non-scaling-stroke"
      ></path>
    </svg>

    <div class="page-container relative z-[2] pt-(--section-space) pb-10 lg:pb-36">
      <div class="max-w-xl lg:max-w-[44%] xl:max-w-[38rem]">
        <p class="flex items-center gap-4 font-sans text-[13px] font-semibold tracking-[0.16em] text-[#97d1f7] uppercase sm:text-[15px]">
          <span
            aria-hidden="true"
            class="h-[4px] w-12 shrink-0 rounded-full bg-brand-yellow"
          ></span>
          {why.eyebrow}
        </p>
        <h2 class="mt-4 font-display text-[2.6rem] leading-[1.04] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-[3.25rem] lg:text-[3rem] xl:text-[3.25rem]">
          {titleTop.map((line) => (
            <span class="block">{line}</span>
          ))}
          <span class="block text-brand-yellow">{titleBottom}</span>
        </h2>
        <p class="mt-5 font-sans text-lg leading-relaxed text-[#8cc6f2] xl:whitespace-pre-line">
          {why.text}
        </p>
        <button
          type="button"
          data-cta="diferenciais-cta"
          class="btn-slave-whats cta cta-yellow mt-7"
        >
          {why.cta}
          <Icon name="arrow-right" class="shrink-0" />
        </button>
        <p class="mt-5 flex items-center gap-2.5 font-sans text-[15px] font-medium text-neutral-light">
          <Icon name="map-pin" class="size-5 shrink-0 text-brand-yellow" />
          {why.area}
        </p>
      </div>
    </div>

    {/* Foto em faixa no rodapé do bloco (mobile) */}
    <div class="why-photo-mobile relative h-64 sm:h-80 lg:hidden">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1020]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-[60%_center]"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>
  </div>

  {/* Cards sobrepostos à base do bloco navy */}
  <div data-why class="page-container relative z-10 -mt-16 lg:-mt-20">
    <ul
      class="why-track scroll-track -mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-5 lg:overflow-visible lg:px-0 lg:pb-0"
      aria-label={why.eyebrow}
    >
      {why.reasons.map((reason) => (
        <li class="flex w-[82%] shrink-0 snap-start items-start gap-4 rounded-2xl bg-neutral-light p-5 shadow-[0_24px_48px_-26px_rgba(0,24,48,0.5)] sm:w-[46%] lg:w-auto 2xl:p-6">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-yellow-soft text-[#00256f] 2xl:size-14">
            <Icon name={reason.icon} class="size-6 2xl:size-7" />
          </span>
          <span class="min-w-0">
            <h3 class="font-display text-[16px] leading-snug font-extrabold text-brand-blue-dark 2xl:text-[18px]">
              {reason.title}
            </h3>
            <p class="mt-1.5 font-sans text-[14px] leading-relaxed text-ink-soft 2xl:text-[15px]">
              {reason.description}
            </p>
          </span>
        </li>
      ))}
    </ul>

    <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
      <button
        type="button"
        data-why-prev
        aria-label="Diferencial anterior"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark"
      >
        <Icon name="chevron-right" class="size-4 rotate-180" />
      </button>
      <button
        type="button"
        data-why-next
        aria-label="Próximo diferencial"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</Section>

<style>
  /* Navy do mockup: um pouco mais claro em cima, mais fundo na base. */
  .why-hero {
    isolation: isolate;
    background: linear-gradient(180deg, #002b59 0%, #00244e 60%, #001d43 100%);
  }

  /* A foto nasce do navy pela esquerda: máscara, para não haver cor a casar. */
  .why-photo {
    -webkit-mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.6) 12%, #000 26%);
    mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.6) 12%, #000 26%);
  }

  /* No mobile, a faixa da foto nasce do navy por cima. */
  .why-photo-mobile {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 35%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 35%);
  }
</style>

<script>
  // Setas do trilho de cards no mobile.
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.why-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-why-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-why-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>
