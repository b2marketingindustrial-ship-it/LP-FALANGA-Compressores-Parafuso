---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.1), com o desvio pedido pelo cliente em
 * 21/10/2026 (mockup da abertura): barra branca com a logo alinhada dentro dela, no
 * lugar da barra navy com a placa pendurada, e CTA em pílula amarela com texto navy.
 * O menu do mockup não entra: uma rota, uma página (regra 1). Registrado em
 * docs/BRIEFING.md (Desvios do padrão).
 *
 * Acabamento de 22/10/2026, a pedido do usuário: filete amarelo-azul no topo, largura de
 * 1680px como o hero (a logo alinha com o texto dele), tagline com selo e a área atendida
 * ao lado, e a sombra só depois que a página rola (`data-scrolled`).
 * Muda só: logo (src/assets/LOGO.png), tagline (site.product) e rótulos (content.header, content.cta).
 */
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/LOGO.png'
import { site } from '../data/site'
import { header, cta } from '../data/content'
---

<header data-header class="site-header sticky top-0 z-50 bg-neutral-light/95 backdrop-blur-md">
  <span
    aria-hidden="true"
    class="block h-[3px] bg-[linear-gradient(90deg,var(--color-brand-yellow)_0%,var(--color-brand-yellow)_40%,var(--color-brand-blue)_100%)]"
  ></span>
  <div class="mx-auto flex max-w-[1680px] items-center justify-between gap-3 px-4 py-3 sm:gap-6 sm:px-6 lg:px-12">
    {/* 1. Logo alinhada na barra */}
    <a href="/" class="flex shrink-0 items-center">
      <Image
        src={logo}
        alt={site.brand}
        width={341}
        height={82}
        format="webp"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        class="header-logo h-10 w-auto sm:h-14"
      />
    </a>

    {/* 2. Tagline com selo e área atendida (somem no mobile) — no lugar do menu do mockup */}
    <div class="hidden flex-1 items-center justify-end gap-6 lg:flex">
      <span class="flex items-center gap-2.5 font-display text-[13px] font-extrabold tracking-[0.14em] text-primary-dark uppercase">
        <span class="flex size-7 items-center justify-center rounded-full bg-brand-yellow-soft text-[#00256f]">
          <Icon name="badge-check" class="size-4" />
        </span>
        {header.tagline}
      </span>
      <span aria-hidden="true" class="h-6 w-px bg-primary-dark/15"></span>
      <span class="flex items-center gap-2 font-sans text-[14px] font-semibold text-ink-soft">
        <Icon name="map-pin" class="size-4 shrink-0 text-brand-blue" />
        {header.area}
      </span>
    </div>

    {/* 3. CTA em pílula amarela, rótulo curto no mobile */}
    <button
      type="button"
      data-cta="header-cta"
      class="btn-slave-whats inline-flex shrink-0 items-center gap-2 rounded-full bg-brand-yellow px-4 py-2 font-sans text-[13px] font-bold text-primary-dark-900 shadow-[0_10px_24px_-14px_rgba(0,24,48,0.6)] ring-1 ring-primary-dark/5 transition-[background-color,transform] duration-200 hover:-translate-y-px hover:bg-brand-yellow-dark motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:px-7 sm:py-3.5 sm:text-[16px]"
    >
      <span class="sm:hidden">{cta.primaryShort}</span>
      <span class="hidden sm:inline">{header.cta}</span>
      <Icon name="arrow-right" class="size-4 [stroke-width:2.4] sm:size-5" />
    </button>
  </div>
</header>

<style>
  /* Linha fina enquanto a página está no topo; sombra quando o conteúdo passa por baixo. */
  .site-header {
    box-shadow: 0 1px 0 rgb(0 33 71 / 0.08);
    transition: box-shadow 0.25s ease;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 14px 30px -20px rgb(0 33 71 / 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  // Sombra do header só depois que a página rola.
  document.querySelectorAll<HTMLElement>('[data-header]').forEach((el) => {
    const update = () => el.toggleAttribute('data-scrolled', window.scrollY > 8)
    update()
    window.addEventListener('scroll', update, { passive: true })
  })
</script>
