---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.4). Grid 1.05fr · 1fr: formulário (shortcode) à esquerda, texto à direita.
 * Mobile: texto antes do formulário. O formulário é sempre o shortcode, nunca um <form> próprio.
 *
 * Desvio pedido pelo cliente em 21/10/2026 (mockup do card de cotação, docs/BRIEFING.md):
 * o formulário fica num card branco com o selo "Solicite sua cotação", o título "Como
 * podemos ajudar?", o subtítulo e a nota com cadeado. O espaço do formulário fica vazio
 * de propósito: nele entra só o shortcode, que o plugin de atendimento do WordPress troca
 * pelo formulário, e ele não define fonte, cor nem alinhamento do conteúdo. O selo sai da
 * coluna de texto, que passa às cores da Falanga. Grid, ordem e CTA seguem os do padrão.
 */
import Icon from './Icon.astro'
import { quote, cta } from '../data/content'
import { site } from '../data/site'

const isDev = import.meta.env.DEV
---

<section id="cotacao" class="bg-neutral-gray-100 py-(--section-space)">
  <div class="page-container">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
      {/* Coluna do formulário: card do mockup com o espaço do shortcode vazio */}
      <div class="order-2 w-full lg:order-1">
        <div class="rounded-[28px] border border-primary-dark/[0.05] bg-neutral-light p-7 shadow-[0_30px_60px_-36px_rgba(0,33,71,0.45)] sm:p-10">
          <p class="flex items-center gap-4 font-sans text-[12px] font-bold tracking-[0.2em] text-primary-dark/80 uppercase">
            <span
              aria-hidden="true"
              class="h-[4px] w-10 shrink-0 rounded-full bg-brand-yellow"
            ></span>
            {quote.eyebrow}
          </p>
          <h3 class="mt-3 font-display text-[2.1rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark sm:text-[2.6rem] xl:text-[2.9rem]">
            {quote.form.title}
          </h3>
          <p class="mt-2 font-sans text-[17px] leading-relaxed text-ink-soft sm:text-lg">
            {quote.form.text}
          </p>

          {/* Espaço do formulário: só o shortcode, sem estilo de texto */}
          <div class="quote-slot mt-7 min-h-[380px] w-full">
            <slot name="shortcode">
              {isDev ? (
                <div
                  class="flex min-h-[380px] w-full flex-col gap-3"
                  aria-label="Mock do formulário (só em desenvolvimento)"
                >
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div class="h-12 rounded-xl border border-neutral-gray-200/70 bg-neutral-gray-100" />
                    <div class="h-12 rounded-xl border border-neutral-gray-200/70 bg-neutral-gray-100" />
                    <div class="h-12 rounded-xl border border-neutral-gray-200/70 bg-neutral-gray-100" />
                    <div class="h-12 rounded-xl border border-neutral-gray-200/70 bg-neutral-gray-100" />
                    <div class="h-12 rounded-xl border border-neutral-gray-200/70 bg-neutral-gray-100 sm:col-span-2" />
                    <div class="h-24 rounded-xl border border-neutral-gray-200/70 bg-neutral-gray-100 sm:col-span-2" />
                  </div>
                  <div class="mt-auto h-14 w-full rounded-xl bg-primary-dark/80" />
                </div>
              ) : (
                <div class="flex min-h-[380px] w-full flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-primary-dark/25 p-8 text-center">
                  <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-blue uppercase">
                    Espaço reservado
                  </span>
                  <p class="font-display text-lg font-bold text-ink">
                    Shortcode — formulário de cotação
                  </p>
                </div>
              )}
            </slot>
          </div>

          {/* Nota de LGPD, com cadeado */}
          <p class="mt-5 flex items-start gap-3 font-sans text-[13px] leading-relaxed text-ink-soft">
            <Icon name="lock" class="size-5 shrink-0 text-primary-dark/70" />
            <span>
              {quote.lgpd}
              {site.privacyUrl && (
                <>
                  {' '}
                  <a
                    href={site.privacyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-primary-dark underline-offset-2 hover:underline"
                  >
                    Política de privacidade
                  </a>
                  .
                </>
              )}
            </span>
          </p>
        </div>
      </div>

      {/* Coluna de texto */}
      <div class="order-1 lg:order-2">
        <h2 class="font-display text-3xl leading-tight font-extrabold tracking-[-0.02em] text-primary-dark sm:text-4xl">
          {quote.title}
        </h2>

        <span
          aria-hidden="true"
          class="mt-5 block h-[4px] w-16 rounded-full bg-brand-yellow"
        ></span>

        <p class="mt-5 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-base">
          {quote.text}
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
          <button type="button" data-cta="cotacao-whatsapp" class="btn-slave-whats cta cta-blue">
            {cta.whatsapp}
            <Icon name="arrow-right" class="shrink-0" />
          </button>
        </div>

        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5">
          {quote.trust.map((item) => (
            <li class="flex items-center gap-2 font-sans text-[13px] font-medium text-ink">
              <Icon name={item.icon} class="size-4 shrink-0 text-brand-blue" />
              {item.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
